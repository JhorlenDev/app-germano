{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "shared",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
